# ============================================
# CADRE — Exemple de configuration
# ============================================
# Copier ce fichier en .env et adapter les valeurs
# cp .env.example .env
#
# ⚠️  NE JAMAIS COMMITER LE FICHIER .env
# ⚠️  Ce fichier ne contient AUCUN secret par défaut
# ============================================

# --- Machine cible (VM Windows) ---
CADRE_VM_IP=192.168.56.104
CADRE_VM_USER=CadreUser
# CADRE_VM_PASS=        # ⚠️ À configurer via `cadre init`, PAS ici

# --- Elasticsearch ---
CADRE_ELASTIC_URL=http://127.0.0.1:9200
CADRE_ELASTIC_USER=elastic
# CADRE_ELASTIC_PASS=   # ⚠️ À configurer via `cadre init`, PAS ici

# --- Kibana ---
CADRE_KIBANA_URL=http://127.0.0.1:5601
CADRE_KIBANA_USER=elastic
# CADRE_KIBANA_TOKEN=   # ⚠️ À configurer via `cadre init`, PAS ici

# --- Ollama (LLM local) ---
CADRE_OLLAMA_URL=http://127.0.0.1:11434
CADRE_OLLAMA_MODEL=llama3.1:8b
# Délai max d'une génération (secondes) : l'inférence locale peut prendre
# 1-2 min sur du matériel modeste, augmentez si "Ollama injoignable" apparaît
# alors qu'Ollama tourne bien.
CADRE_OLLAMA_TIMEOUT_SEC=180

# --- Timeouts et seuils ---
CADRE_TIMEOUT_INDEXATION=180
CADRE_TIMEOUT_WINRM=30
CADRE_SEUIL_FP=50
CADRE_FENETRE_TP_SEC=600
CADRE_FENETRE_FP_SEC=604800

# --- Mode ---
CADRE_LOG_LEVEL=INFO
CADRE_DRY_RUN=false
CADRE_ANONYMISER=true

# --- Réseau (optionnel, pour tests offensifs) ---
# CADRE_KALI_IP=192.168.56.105

# --- Notifications (optionnel) ---
# CADRE_SLACK_WEBHOOK=
# CADRE_DISCORD_WEBHOOK=
